# CogniForge Virtual API Configuration

# Model
COGNIFORGE_MODEL=cogniforge/videogen-xl

# Storage
OUTPUT_DIR=/mnt/virtual_vram/outputs

# Server
VIRTUAL_API_PORT=8000
ALLOWED_ORIGINS=*

# Generation limits
MAX_DURATION_MINUTES=30
GENERATION_CHUNK_SIZE=16
MAX_RESOLUTION=7680

# CogniForge VX driver path (mounted from host)
COGNIFORGE_DRIVER_PATH=/mnt/host-drivers
